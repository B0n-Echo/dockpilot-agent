# Copy this file to .env and fill in your own values. .env is ignored by git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional tracing. DOCKPILOT_TRACE=1 records every step locally ("What happened?", python -m dockpilot.trace).
# LANGSMITH_TRACING=true also records, and sends each turn to LangSmith (needs the key). false = keep the key, send nothing.
DOCKPILOT_TRACE=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dockpilot
# Only for LangSmith's EU region: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
